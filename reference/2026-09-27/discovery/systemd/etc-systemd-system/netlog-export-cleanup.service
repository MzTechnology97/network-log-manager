[Unit]
Description=Network Log Manager export cleanup
After=mariadb.service
Wants=mariadb.service

[Service]
Type=oneshot
User=netlog
Group=netlog
WorkingDirectory=/opt/netlog-manager

ExecStart=/opt/netlog-manager/venv/bin/python -m app.export_cleanup --delete

Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

ReadWritePaths=/var/cache/netlog-manager/exports
