[Unit]
Description=Network Log Manager - Historical Search Cache Builder
After=mariadb.service
Wants=mariadb.service

[Service]
Type=oneshot
User=netlog
Group=netlog
WorkingDirectory=/opt/netlog-manager

Environment=PYTHONDONTWRITEBYTECODE=1

ExecStartPre=/opt/netlog-manager/venv/bin/python -m app.archive_catalog --write
ExecStart=/opt/netlog-manager/venv/bin/python -m app.archive_cache_worker --limit 25

Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7

PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

ReadWritePaths=/var/cache/netlog-manager

StandardOutput=journal
StandardError=journal
