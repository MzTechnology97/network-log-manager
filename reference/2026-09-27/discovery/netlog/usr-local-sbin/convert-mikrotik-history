#!/bin/bash

set -u
set -o pipefail

DB="syslogdb"
MYSQL=(mysql -u root -N -B "$DB")
MYSQL_HUMAN=(mysql -u root "$DB")

CUTOFF="mikrotik_logs_2026_09_21"
LOG="/var/log/convert-mikrotik-history.log"

DRY_RUN=0
LIMIT=0
SINGLE_TABLE=""
MODE=""
PURGE_OLD=0

log()
{
    local msg
    msg="$(date '+%Y-%m-%d %H:%M:%S') $*"
    echo "$msg"
    echo "$msg" >> "$LOG"
}

die()
{
    log "ERRORE: $*"
    exit 1
}

usage()
{
    cat <<USAGE
Uso:

  $0 --dry-run
  $0 --table mikrotik_logs_YYYY_MM_DD
  $0 --limit N
  $0 --all

Opzioni:

  --dry-run     Mostra le tabelle candidate senza modificarle
  --table NAME  Converte una singola tabella
  --limit N     Converte al massimo N tabelle
  --all         Converte tutte le tabelle candidate

Limite storico:
  <= 2026-09-21

Le tabelle 2026-09-22 e successive NON vengono toccate.
USAGE
}


# ------------------------------------------------------------
# ARGOMENTI
# ------------------------------------------------------------

while [ $# -gt 0 ]; do
    case "$1" in

        --dry-run)
            DRY_RUN=1
            MODE="dry"
            shift
            ;;

        --table)
            [ $# -ge 2 ] || die "--table richiede un nome tabella"
            SINGLE_TABLE="$2"
            MODE="table"
            shift 2
            ;;

        --limit)
            [ $# -ge 2 ] || die "--limit richiede un numero"
            LIMIT="$2"

            [[ "$LIMIT" =~ ^[0-9]+$ ]] ||
                die "Valore --limit non valido"

            [ "$LIMIT" -gt 0 ] ||
                die "--limit deve essere > 0"

            MODE="limit"
            shift 2
            ;;

        --all)
            MODE="all"
            shift
            ;;

        --purge-old)
            PURGE_OLD=1
            shift
            ;;

        -h|--help)
            usage
            exit 0
            ;;

        *)
            usage
            die "Parametro sconosciuto: $1"
            ;;
    esac
done


[ -n "$MODE" ] || {
    usage
    exit 1
}


# ------------------------------------------------------------
# FUNZIONI MYSQL
# ------------------------------------------------------------

sql()
{
    "${MYSQL[@]}" -e "$1"
}

table_exists()
{
    local table="$1"

    local n
    n=$(sql "
        SELECT COUNT(*)
        FROM information_schema.TABLES
        WHERE TABLE_SCHEMA='$DB'
          AND TABLE_NAME='$table';
    ")

    [ "$n" = "1" ]
}


# ------------------------------------------------------------
# CONTROLLO SE TABELLA È GIÀ NEL FORMATO STORICO FINALE
# ------------------------------------------------------------

is_final_schema()
{
    local table="$1"

    local result

    result=$(sql "
        SELECT CONCAT_WS('|',
            MAX(CASE WHEN COLUMN_NAME='id'
                     THEN COLUMN_TYPE END),

            MAX(CASE WHEN COLUMN_NAME='timestamp'
                     THEN COLUMN_TYPE END),

            MAX(CASE WHEN COLUMN_NAME='source_ip'
                     THEN COLUMN_TYPE END),

            MAX(CASE WHEN COLUMN_NAME='source_port'
                     THEN COLUMN_TYPE END),

            MAX(CASE WHEN COLUMN_NAME='dest_ip'
                     THEN COLUMN_TYPE END),

            MAX(CASE WHEN COLUMN_NAME='dest_port'
                     THEN COLUMN_TYPE END),

            MAX(CASE WHEN COLUMN_NAME='protocol'
                     THEN COLUMN_TYPE END)
        )
        FROM information_schema.COLUMNS
        WHERE TABLE_SCHEMA='$DB'
          AND TABLE_NAME='$table';
    ")

    case "$result" in
        "int(10) unsigned|datetime(3)|varchar(15)|smallint(5) unsigned|varchar(15)|smallint(5) unsigned|varchar(5)")
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}


# ------------------------------------------------------------
# PRE-CHECK DATI
# ------------------------------------------------------------

precheck()
{
    local table="$1"

    log "Pre-check $table..."

    local result

    result=$(sql "
        SELECT CONCAT_WS('|',

            COUNT(*),

            SUM(timestamp IS NULL OR timestamp=''),

            SUM(source_ip IS NULL OR source_ip=''),

            SUM(dest_ip IS NULL OR dest_ip=''),

            SUM(CHAR_LENGTH(source_ip)>15),

            SUM(CHAR_LENGTH(dest_ip)>15),

            SUM(
                CAST(source_port AS CHAR)
                NOT REGEXP '^[0-9]+$'
            ),

            SUM(
                CAST(dest_port AS CHAR)
                NOT REGEXP '^[0-9]+$'
            ),

            SUM(
                CAST(source_port AS CHAR)
                    REGEXP '^[0-9]+$'
                AND CAST(source_port AS UNSIGNED)>65535
            ),

            SUM(
                CAST(dest_port AS CHAR)
                    REGEXP '^[0-9]+$'
                AND CAST(dest_port AS UNSIGNED)>65535
            ),

            SUM(
                CAST(protocol AS CHAR)
                NOT IN ('1','6','17','58',
                        'TCP','UDP','ICMP','ICMP6')
            )

        )
        FROM \`$table\`;
    ") || return 1

    IFS='|' read -r \
        rows \
        timestamp_bad \
        source_null \
        dest_null \
        source_long \
        dest_long \
        sport_bad \
        dport_bad \
        sport_range \
        dport_range \
        proto_bad <<< "$result"


    log "Righe: $rows"

    if [ "$timestamp_bad" != "0" ] ||
       [ "$source_null"   != "0" ] ||
       [ "$dest_null"     != "0" ] ||
       [ "$source_long"   != "0" ] ||
       [ "$dest_long"     != "0" ] ||
       [ "$sport_bad"     != "0" ] ||
       [ "$dport_bad"     != "0" ] ||
       [ "$sport_range"   != "0" ] ||
       [ "$dport_range"   != "0" ] ||
       [ "$proto_bad"     != "0" ]; then

        log "PRE-CHECK FALLITO:"
        log " timestamp_bad=$timestamp_bad"
        log " source_null=$source_null"
        log " dest_null=$dest_null"
        log " source_long=$source_long"
        log " dest_long=$dest_long"
        log " source_port_non_numeric=$sport_bad"
        log " dest_port_non_numeric=$dport_bad"
        log " source_port_range=$sport_range"
        log " dest_port_range=$dport_range"
        log " protocol_bad=$proto_bad"

        return 1
    fi

    return 0
}


# ------------------------------------------------------------
# CONVERSIONE
# ------------------------------------------------------------

convert_table()
{
    local table="$1"
    local new="${table}_new"
    local old="${table}_old"

    log "============================================================"
    log "Inizio conversione: $table"


    # Sicurezza sul nome
    [[ "$table" =~ ^mikrotik_logs_[0-9]{4}_[0-9]{2}_[0-9]{2}$ ]] ||
        die "Nome tabella non valido: $table"


    # Cutoff
    [[ "$table" > "$CUTOFF" ]] &&
        die "$table supera il limite storico $CUTOFF"


    table_exists "$table" ||
        die "Tabella $table inesistente"


    # Già convertita
    if is_final_schema "$table"; then
        log "SKIP: $table è già nello schema finale."
        return 0
    fi


    # Non sovrascriviamo mai backup
    if table_exists "$old"; then
        die "Esiste già $old. Intervento manuale richiesto."
    fi


    # Non sovrascriviamo _new residui
    if table_exists "$new"; then
        die "Esiste già $new. Intervento manuale richiesto."
    fi


    # --------------------------------------------------------
    # PRECHECK
    # --------------------------------------------------------

    precheck "$table" ||
        die "Pre-check fallito per $table"


    # --------------------------------------------------------
    # METADATI ORIGINALE
    # --------------------------------------------------------

    local original_count
    local original_min
    local original_max

    original_count=$(sql "
        SELECT COUNT(*)
        FROM \`$table\`;
    ")

    original_min=$(sql "
        SELECT MIN(timestamp)
        FROM \`$table\`;
    ")

    original_max=$(sql "
        SELECT MAX(timestamp)
        FROM \`$table\`;
    ")

    log "Originale:"
    log " righe=$original_count"
    log " min=$original_min"
    log " max=$original_max"


    # --------------------------------------------------------
    # CREAZIONE NUOVA TABELLA
    # --------------------------------------------------------

    log "Creazione $new..."

    "${MYSQL_HUMAN[@]}" <<SQL
CREATE TABLE \`$new\` (

    id INT UNSIGNED NOT NULL AUTO_INCREMENT,

    timestamp DATETIME(3) NOT NULL,

    source_ip VARCHAR(15)
        CHARACTER SET ascii COLLATE ascii_bin NOT NULL,

    source_port SMALLINT UNSIGNED NOT NULL,

    dest_ip VARCHAR(15)
        CHARACTER SET ascii COLLATE ascii_bin NOT NULL,

    dest_port SMALLINT UNSIGNED NOT NULL,

    protocol VARCHAR(5)
        CHARACTER SET ascii COLLATE ascii_bin NOT NULL,

    PRIMARY KEY (id)

)
ENGINE=InnoDB
ROW_FORMAT=COMPRESSED
KEY_BLOCK_SIZE=8;
SQL

    [ $? -eq 0 ] ||
        die "Errore creazione $new"


    # --------------------------------------------------------
    # COPIA / CONVERSIONE
    # --------------------------------------------------------

    log "Copia dati in corso..."

    local start
    local end

    start=$(date +%s)

    "${MYSQL_HUMAN[@]}" <<SQL
INSERT INTO \`$new\`
(
    timestamp,
    source_ip,
    source_port,
    dest_ip,
    dest_port,
    protocol
)
SELECT

    CAST(LEFT(CAST(timestamp AS CHAR),23) AS DATETIME(3)),

    source_ip,

    CAST(source_port AS UNSIGNED),

    dest_ip,

    CAST(dest_port AS UNSIGNED),

    CASE
        WHEN CAST(protocol AS CHAR)='6'
            THEN 'TCP'

        WHEN CAST(protocol AS CHAR)='17'
            THEN 'UDP'

        WHEN CAST(protocol AS CHAR)='1'
            THEN 'ICMP'

        WHEN CAST(protocol AS CHAR)='58'
            THEN 'ICMP6'

        ELSE CAST(protocol AS CHAR)
    END

FROM \`$table\`;
SQL

    if [ $? -ne 0 ]; then
        log "ERRORE durante INSERT."
        log "$new viene mantenuta per analisi."
        exit 1
    fi

    end=$(date +%s)

    log "Copia completata in $((end-start)) secondi."


    # --------------------------------------------------------
    # ANALYZE
    # --------------------------------------------------------

    sql "ANALYZE TABLE \`$new\`;" >/dev/null


    # --------------------------------------------------------
    # VALIDAZIONE
    # --------------------------------------------------------

    local new_count
    local new_min
    local new_max

    new_count=$(sql "
        SELECT COUNT(*)
        FROM \`$new\`;
    ")

    new_min=$(sql "
        SELECT MIN(timestamp)
        FROM \`$new\`;
    ")

    new_max=$(sql "
        SELECT MAX(timestamp)
        FROM \`$new\`;
    ")


    log "Nuova:"
    log " righe=$new_count"
    log " min=$new_min"
    log " max=$new_max"


    if [ "$original_count" != "$new_count" ]; then
        die "COUNT differente: originale=$original_count nuova=$new_count"
    fi


    # Confronto MIN/MAX normalizzati

    local expected_min
    local expected_max

    expected_min=$(sql "
        SELECT CAST(
            LEFT(CAST(MIN(timestamp) AS CHAR),23)
            AS DATETIME(3)
        )
        FROM \`$table\`;
    ")

    expected_max=$(sql "
        SELECT CAST(
            LEFT(CAST(MAX(timestamp) AS CHAR),23)
            AS DATETIME(3)
        )
        FROM \`$table\`;
    ")


    if [ "$expected_min" != "$new_min" ]; then
        die "MIN timestamp differente."
    fi

    if [ "$expected_max" != "$new_max" ]; then
        die "MAX timestamp differente."
    fi


    # --------------------------------------------------------
    # CONTROLLO PROTOCOLLI
    # --------------------------------------------------------

    local bad_protocols

    bad_protocols=$(sql "
        SELECT COUNT(*)
        FROM \`$new\`
        WHERE protocol NOT IN
              ('TCP','UDP','ICMP','ICMP6');
    ")

    if [ "$bad_protocols" != "0" ]; then
        die "Protocollo inatteso nella nuova tabella."
    fi


    # --------------------------------------------------------
    # RENAME ATOMICO
    # --------------------------------------------------------

    log "Validazione OK."
    log "Eseguo RENAME atomico..."

    sql "
        RENAME TABLE
            \`$table\` TO \`$old\`,
            \`$new\`   TO \`$table\`;
    " || die "RENAME fallito"


    # --------------------------------------------------------
    # VERIFICA POST-SWAP
    # --------------------------------------------------------

    local final_count

    final_count=$(sql "
        SELECT COUNT(*)
        FROM \`$table\`;
    ")

    if [ "$final_count" != "$original_count" ]; then
        die "ERRORE CRITICO: COUNT post-swap differente."
    fi


    log "CONVERSIONE COMPLETATA:"
    log " $table"
    log " righe=$final_count"
    log " backup=$old"

    # --------------------------------------------------------
    # ELIMINAZIONE BACKUP ORIGINALE
    # --------------------------------------------------------

    if [ "$PURGE_OLD" -eq 1 ]; then

        log "Verifica finale prima della cancellazione di $old..."

        local old_count

        old_count=$(sql "
            SELECT COUNT(*)
            FROM \`$old\`;
        ")

        if [ "$old_count" != "$final_count" ]; then
            die "COUNT backup differente: old=$old_count nuova=$final_count"
        fi

        log "COUNT backup OK: $old_count"
        log "Eliminazione $old..."

        sql "DROP TABLE \`$old\`;" ||
            die "Impossibile eliminare $old"

        log "Backup originale eliminato."

    else

        log "Backup originale mantenuto: $old"

    fi

    log "============================================================"

    return 0
}


# ------------------------------------------------------------
# COSTRUZIONE LISTA
# ------------------------------------------------------------

if [ "$MODE" = "table" ]; then

    [[ "$SINGLE_TABLE" =~ ^mikrotik_logs_[0-9]{4}_[0-9]{2}_[0-9]{2}$ ]] ||
        die "Nome tabella non valido."

    TABLES="$SINGLE_TABLE"

else

    TABLES=$(sql "
        SELECT TABLE_NAME
        FROM information_schema.TABLES
        WHERE TABLE_SCHEMA='$DB'
          AND TABLE_NAME REGEXP
              '^mikrotik_logs_[0-9]{4}_[0-9]{2}_[0-9]{2}$'
          AND TABLE_NAME <= '$CUTOFF'
        ORDER BY TABLE_NAME DESC;
    ")

fi


# ------------------------------------------------------------
# DRY RUN
# ------------------------------------------------------------

if [ "$DRY_RUN" -eq 1 ]; then

    echo
    echo "Tabelle candidate <= 2026-09-21:"
    echo

    count=0

    while read -r table; do

        [ -z "$table" ] && continue

        if is_final_schema "$table"; then
            printf "%-32s GIA_CONVERTITA\n" "$table"
        elif table_exists "${table}_old"; then
            printf "%-32s BACKUP_OLD_PRESENTE\n" "$table"
        else
            printf "%-32s DA_CONVERTIRE\n" "$table"
        fi

        count=$((count+1))

    done <<< "$TABLES"

    echo
    echo "Totale tabelle esaminate: $count"

    exit 0
fi


# ------------------------------------------------------------
# ESECUZIONE
# ------------------------------------------------------------

processed=0

while read -r table; do

    [ -z "$table" ] && continue

    if is_final_schema "$table"; then
        log "SKIP $table: già convertita."
        continue
    fi

    convert_table "$table" || exit 1

    processed=$((processed+1))

    if [ "$MODE" = "limit" ] &&
       [ "$processed" -ge "$LIMIT" ]; then
        break
    fi

done <<< "$TABLES"


log "Operazione terminata. Tabelle convertite: $processed"

exit 0
