[Unit]
Description=Network Log Manager - Export Worker
After=mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=netlog
Group=netlog
WorkingDirectory=/opt/netlog-manager
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/netlog-manager/scripts/native-worker.sh export-worker
Restart=always
RestartSec=10
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/cache/netlog-manager/exports /var/lib/netlog-manager
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
